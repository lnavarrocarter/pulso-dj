{
  "name": "pulso-dj",
  "version": "0.5.0",
  "private": true,
  "description": "Base de aplicación DJ para Windows, macOS y Linux",
  "homepage": "https://github.com/lnavarrocarter/pulso-dj",
  "author": { "name": "Nacho Navarro", "email": "lnavarrocarter@users.noreply.github.com" },
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "prestart": "node desktop/prepare-tools.cjs",
    "tools:prepare": "node desktop/prepare-tools.cjs",
    "predist": "node desktop/prepare-tools.cjs",
    "prepack": "node desktop/prepare-tools.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "electron desktop/smoke.cjs",
    "test:youtube": "electron desktop/youtube-smoke.cjs",
    "test:assistant": "electron desktop/assistant-smoke.cjs",
    "midi:monitor": "electron desktop/midi-monitor.cjs",
    "midi:guided": "electron desktop/midi-monitor.cjs --guided",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": { "electron": "44.7.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "dev.pulsodj.desktop",
    "productName": "Pulso DJ",
    "files": ["desktop/**", "src/**", "package.json"],
    "directories": { "output": "release" },
    "extraResources": [{ "from": "assets/tools/${os}", "to": "tools" }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "artifactName": "Pulso-DJ-${version}-Windows-Setup.${ext}" },
    "linux": { "target": ["AppImage", "deb"], "category": "AudioVideo", "executableName": "pulso-dj", "synopsis": "Mezcla con 4 decks, controladoras MIDI y pedidos del público", "maintainer": "Nacho Navarro <lnavarrocarter@users.noreply.github.com>", "artifactName": "Pulso-DJ-${version}-Linux-${arch}.${ext}" },
    "mac": { "target": "dmg", "category": "public.app-category.music", "extendInfo": { "NSCameraUsageDescription": "Pulso DJ usa la cámara, cuando la activas, para medir movimiento visual localmente y adaptar la capa musical." } }
  }
}
